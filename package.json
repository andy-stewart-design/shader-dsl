    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
