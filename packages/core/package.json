{
  "name": "@shdr/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "pretest": "playwright install chromium",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:webgl": "playwright install chromium && vitest run --config ../../vitest.config.ts --root . test/generated-glsl-webgl.test.ts",
    "test:webgl:headed": "playwright install chromium && SHDR_WEBGL_HEADED=1 vitest run --config ../../vitest.config.ts --root . test/generated-glsl-webgl.test.ts"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "8.0.4",
    "shdr": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "playwright": "^1.63.0",
    "tsdown": "^0.22.5",
    "typescript": "7.0.2"
  }
}
