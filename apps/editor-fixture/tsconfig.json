{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "paths": {
      "@fixture/*": ["./shared/*"]
    }
  },
  "include": ["*.ts", "shared/*.shdr.ts", "test/fixtures/*.shdr.ts"]
}
